# Database
DATABASE_URL=postgresql+asyncpg://neocloud:neocloud_dev@localhost:5432/neocloud

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=RS256
COGNITO_USER_POOL_ID=us-east-1_XXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=us-east-1

# AWS
AWS_REGION=us-east-1
AWS_EVENTBRIDGE_BUS=neocloud-domain-events
AWS_S3_BUCKET=neocloud-documents

# App
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000
