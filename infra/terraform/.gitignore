# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Keep .terraform.lock.hcl committed for reproducible provider versions.

# Variable files that may contain secrets
*.tfvars
!terraform.tfvars.example
# Per-env tfvars are non-secret (client secret passed separately at apply time).
!envs/dev.tfvars
!envs/prod.tfvars

# Plan output
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
